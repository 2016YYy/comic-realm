#!/usr/bin/env bash
# 提交前敏感信息扫描（由 scripts/install-hooks.sh 安装到 .git/hooks/）
# 发现泄露时阻止提交。

set -uo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

EXE=""
for c in "$REPO_ROOT/tools/bin/gitleaks" "$REPO_ROOT/tools/bin/gitleaks.exe"; do
  if [ -x "$c" ]; then EXE="$c"; break; fi
done
if [ -z "$EXE" ] && command -v gitleaks >/dev/null 2>&1; then
  EXE="$(command -v gitleaks)"
fi
if [ -z "$EXE" ]; then
  echo "[secret-scan] 未找到 gitleaks，跳过本次扫描。" >&2
  echo "[secret-scan] 建议安装：bash scripts/install-hooks.sh 会自动准备。" >&2
  exit 0
fi

# 只扫暂存内容，避免因历史遗留问题阻塞日常提交
CFG_ARGS=()
[ -f "$REPO_ROOT/gitleaks.toml" ] && CFG_ARGS=(--config "$REPO_ROOT/gitleaks.toml")

echo "[secret-scan] 检查暂存文件中的敏感信息…"
if ! "$EXE" git --staged --redact -v "${CFG_ARGS[@]}"; then
  echo "" >&2
  echo "[secret-scan] ✘ 暂存区发现敏感信息，提交已被阻止。" >&2
  echo "            确认是误报可加 # gitleaks:allow 或更新 gitleaks.toml 白名单。" >&2
  exit 1
fi
echo "[secret-scan] ✔ 未发现泄露"
exit 0